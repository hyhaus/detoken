# Detoken — Hostinger (Apache/LiteSpeed)
# Força HTTPS — DESCOMENTE as 3 linhas abaixo SÓ depois que o SSL estiver ativo no hPanel
# (antes disso vira redirect para um endereço sem certificado = erro no navegador)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Cache: imagens e ícones por 30 dias; o HTML nunca (para o preview do link atualizar)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType application/manifest+json .webmanifest
